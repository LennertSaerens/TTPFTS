# Experiment outputs (large, regenerated; archived separately when needed)
/results/
/results5000/
/results_corr/
/results_preregistered_final*/
/results_uq_hardness*/
/results_p_sweep*/
/figures/
# Final publication artifacts are evidence and are tracked.
!/figures/publication/

# Bulk archived evidence: preserved on disk and on the HPC with SHA-256
# manifests, but far too large for git (~2.2 GB). Exclude the heavy payload
# directories file-by-file so the small manifests/inventories stay tracked and
# the archives remain independently verifiable.
/archive_prepatch/results/**
/archive_prepatch/figures/**
/archive_provisional/hpc_job_49697/results/**
/archive_provisional/hpc_job_49697/logs/**

# Raw result CSVs are outputs, not source. Frozen benchmark instances and
# generated audit reports are scientific evidence and ARE tracked (negated
# below), because reproducibility depends on them.
*.csv
!environments/instances/*.csv
!environments/reports/*.csv
!experiments/reports/*.csv
!experiments/heteroscedastic/instances/*.csv
!experiments/heteroscedastic/reports/*.csv
!experiments/heterogeneous_ensemble/instances/*.csv
!experiments/heterogeneous_ensemble/reports/*.csv
!experiments/gap_noise_alignment/instances/*.csv
!experiments/gap_noise_alignment/reports/*.csv
!experiments/information_matched/reports/*.csv
!experiments/uq/reports/*.json
!experiments/uq_kv/reports/*.csv
!experiments/uq_kv/reports/*.json

/results_gap_noise_alignment_*/
/results_ege_doubling_*/
/results_information_matched_*/
/results_uq_known_var*/

# Python bytecode
__pycache__/
*.py[cod]

# Editor / OS cruft
.idea/
.vscode/
.DS_Store
.copilot/

# Virtualenvs
.venv/
venv/
